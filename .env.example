# Runtime
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
FORCE_HTTPS=false

# Neon PostgreSQL (replace every uppercase placeholder)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
NEON_DNS_SERVERS=

# Authentication
JWT_SECRET_KEY=replace-with-a-unique-random-value-of-at-least-32-bytes

# Google Gemini
LLM_API_KEY=replace-with-your-gemini-api-key
LLM_MODEL=gemini-2.5-flash
AI_REQUESTS_PER_MINUTE=30
CAREER_AI_REQUESTS_PER_MINUTE=6
INTERVIEW_AI_REQUESTS_PER_MINUTE=4
INTERVIEW_MAX_ANSWER_CHARS=20000

# Feature activation
ENABLE_CAREER_INTELLIGENCE=false
ENABLE_JOB_DISCOVERY=false
ENABLE_ADVANCED_FEATURES=false

# Job discovery
JOB_PROVIDER=himalayas
HIMALAYAS_API_KEY=replace-with-your-himalayas-api-key
HIMALAYAS_API_BASE_URL=https://himalayas.app/jobs/api
JOB_SEARCH_REQUESTS_PER_MINUTE=10
JOB_IMPORT_REQUESTS_PER_MINUTE=5
JOB_PROVIDER_TIMEOUT_SECONDS=12
JOB_IMPORT_MAX_BYTES=2000000
REMINDER_WORKER_TOKEN=

# Optional Gmail integration (disabled by default)
ENABLE_GMAIL=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GMAIL_TOKEN_ENCRYPTION_KEY=
OAUTH_STATE_TTL_MINUTES=10
